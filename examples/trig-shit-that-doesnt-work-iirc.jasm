    rldi    0xEC @04 @58
    rldi    0xFB @04 @59
    rldi    0xFF @04 @5A

    ; High section (91 items)
    rldi    0x00 @04 @5B
    rldi    0x02 @04 @5C
    rldi    0x04 @04 @5D
    rldi    0x06 @04 @5E
    rldi    0x08 @04 @5F
    rldi    0x0B @04 @60
